---
import { categories, getToolsByCategory, toolRegistry } from '../config/tools'
import {
  t,
  getCategoryName,
  getOtherLanguages,
  languages,
  languageNames,
  getToolNameKey,
  getToolDescKey,
} from '../i18n'
import type { Language } from '../i18n'
import { sortToolsByLocalizedName } from '../lib/tool-order'
import { appVersion, upstreamRepositoryUrl } from '../config/site'
import { iconInner, iconSvg, toolIconSvg, hueOf } from '../lib/icons'

interface Props {
  lang: Language
}

const { lang } = Astro.props
const otherLangs = getOtherLanguages(lang)
const totalTools = toolRegistry.length

const categoryBlurbKey: Record<string, string> = {
  'text-processing': 'categoryBlurb_textProcessing',
  generators: 'categoryBlurb_generators',
  extraction: 'categoryBlurb_extraction',
  analysis: 'categoryBlurb_analysis',
  security: 'categoryBlurb_security',
  converters: 'categoryBlurb_converters',
  development: 'categoryBlurb_development',
  utilities: 'categoryBlurb_utilities',
}

// Client-side lookup map for recents + favorites hydration.
const homeToolData: Record<
  string,
  { name: string; desc: string; cat: string; hue: string; icon: string; iconSm: string }
> = {}
for (const tool of toolRegistry) {
  homeToolData[tool.id] = {
    name: t(lang, getToolNameKey(tool.id)),
    desc: t(lang, getToolDescKey(tool.id)),
    cat: getCategoryName(lang, tool.category),
    hue: hueOf(tool.category),
    icon: toolIconSvg(tool.id),
    iconSm: toolIconSvg(tool.id, 'icon-sm'),
  }
}

const timeStrings = {
  justNow: t(lang, 'time_justNow'),
  m: t(lang, 'time_minutesAgoSuffix'),
  h: t(lang, 'time_hoursAgoSuffix'),
  d: t(lang, 'time_daysAgoSuffix'),
  arrow: iconSvg('arrow', 'icon-sm arrow'),
  star: iconSvg('star', 'icon-sm'),
  emptyText: t(lang, 'home_recentsEmpty'),
}
const favStrings = {
  star: iconSvg('star', 'icon-sm'),
  emptyText: t(lang, 'home_favoritesEmpty'),
}
---

<div class="min-h-screen">
  <!-- TOP BAR -->
  <header class="topbar">
    <div class="wrap topbar-in">
      <a href={`/${lang}/`} class="brand" aria-label={t(lang, 'app_backHomeAria')}>
        <span class="mark"></span>
        <span class="word">{t(lang, 'app_title')}</span>
        <span class="ver">v{appVersion}</span>
      </a>
      <button type="button" class="search-trigger" id="home-search-trigger" aria-label={t(lang, 'app_searchPlaceholder')}>
        <Fragment set:html={iconSvg('search', 'icon-sm')} />
        <span class="grow">{t(lang, 'app_searchPlaceholder')}</span>
        <span class="kbd">⌘</span><span class="kbd">K</span>
      </button>
      <div class="topbar-right">
        <div class="relative" data-lang-dropdown>
          <button
            type="button"
            class="lang"
            title={t(lang, 'app_switchLanguageAria')}
            aria-haspopup="true"
            aria-expanded="false"
          >
            {lang.toUpperCase()}
            <Fragment set:html={iconSvg('chev', 'icon-sm')} />
          </button>
          <div class="absolute right-0 top-full z-50 mt-1 hidden min-w-[8rem] overflow-hidden rounded-lg border border-border bg-surface-raised shadow-lg" data-lang-menu>
            {otherLangs.map((l) => (
              <a
                href={`/${l}/`}
                class="flex items-center gap-2 px-3 py-2 text-sm text-text-secondary hover:bg-surface hover:text-accent transition-colors"
              >
                <span class="w-6 font-medium">{l.toUpperCase()}</span>
                <span class="text-text-muted">{languageNames[l]}</span>
              </a>
            ))}
          </div>
        </div>
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          aria-label={t(lang, 'app_themeToggleAria')}
          title={t(lang, 'app_themeToggleAria')}
        >
          <svg id="theme-icon-light" class="icon hidden" viewBox="0 0 24 24" aria-hidden="true" set:html={iconInner('sun')} />
          <svg id="theme-icon-dark" class="icon hidden" viewBox="0 0 24 24" aria-hidden="true" set:html={iconInner('moon')} />
          <svg id="theme-icon-system" class="icon hidden" viewBox="0 0 24 24" aria-hidden="true" set:html={iconInner('monitor')} />
        </button>
        <a class="icon-link" href={upstreamRepositoryUrl} aria-label="GitHub" target="_blank" rel="noopener">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none" set:html={iconInner('github')} />
        </a>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <span class="ws-eyebrow">{t(lang, 'home_heroEyebrow')}</span>
      <h1>{t(lang, 'home_heroTitlePre')}<em>{t(lang, 'home_heroTitleEm')}</em>{t(lang, 'home_heroTitlePost')}</h1>
      <p class="ws-lede">{t(lang, 'home_heroLede')}</p>
      <div class="hero-meta">
        <span class="chip"><span class="dot" style="background:var(--accent)"></span><b>{totalTools}</b>&nbsp;{t(lang, 'home_heroMetaTools')}</span>
        <span class="chip"><b>{categories.length}</b>&nbsp;{t(lang, 'home_heroMetaCategories')}</span>
        <span class="chip"><span class="dot" style="background:var(--c-convert)"></span><b>100%</b>&nbsp;{t(lang, 'home_heroMetaClientSide')}</span>
        <span class="chip"><b>{languages.length}</b>&nbsp;{t(lang, 'home_heroMetaLanguages')}</span>
      </div>
    </div>
  </section>

  <!-- WORKBENCH BAND: recents + favorites -->
  <section class="band">
    <div class="wrap band-in">
      <div>
        <h2>
          <Fragment set:html={iconSvg('clock', 'icon-sm')} />
          {t(lang, 'home_jumpBackIn')} <span class="count" id="home-recents-count"></span>
        </h2>
        <div class="recent-row" id="home-recents-row"></div>
      </div>
      <div id="home-favorites" data-lang={lang}>
        <h2>
          <Fragment set:html={iconSvg('star', 'icon-sm')} />
          {t(lang, 'favorites_title')} <span class="count" id="home-favorites-count"></span>
        </h2>
        <div class="fav-grid" id="home-favorites-grid"></div>
      </div>
    </div>
  </section>

  <!-- CATALOG -->
  <main id="main-content" class="catalog">
    <div class="wrap catalog-in">
      <nav class="toc" id="home-toc" aria-label={t(lang, 'home_catalogLabel')}>
        <div class="toc-title">{t(lang, 'home_catalogLabel')}</div>
        <div id="home-toc-list">
          {categories.map((cat) => {
            const count = getToolsByCategory(cat).length
            return (
              <a href={`#cat-${cat}`} data-slug={cat} style={`--hue:${hueOf(cat)}`}>
                <span class="dot"></span>{getCategoryName(lang, cat)}<span class="tcount">{count}</span>
              </a>
            )
          })}
        </div>
        <div class="privacy">
          <Fragment set:html={iconSvg('shieldcheck', 'icon-sm')} />
          <span>{t(lang, 'home_privacyNote')}</span>
        </div>
      </nav>

      <div id="home-sections">
        {categories.map((cat, i) => {
          const tools = sortToolsByLocalizedName(lang, getToolsByCategory(cat))
          const num = String(i + 1).padStart(2, '0')
          return (
            <section class="cat-section" id={`cat-${cat}`} style={`--hue:${hueOf(cat)}`}>
              <div class="cat-head">
                <span class="num">{num}</span>
                <span class="ctext">
                  <h2>{getCategoryName(lang, cat)}</h2>
                  <p>{t(lang, categoryBlurbKey[cat] as never)}</p>
                </span>
                <span class="ccount">{tools.length} {t(lang, 'units_tools')}</span>
              </div>
              <div class="tool-grid">
                {tools.map((tool) => (
                  <a class="tool-card" href={`/${lang}/tools/${tool.id}/`} data-id={tool.id}>
                    <span class="tile" style={`--tint:${hueOf(tool.category)}`} set:html={toolIconSvg(tool.id)} />
                    <span class="body">
                      <span class="name">{t(lang, getToolNameKey(tool.id))}</span>
                      <span class="desc">{t(lang, getToolDescKey(tool.id))}</span>
                    </span>
                    <button class="favbtn" type="button" data-fav={tool.id} aria-label={t(lang, 'favorites_add')} title={t(lang, 'favorites_title')}>
                      <Fragment set:html={iconSvg('star', 'icon-sm')} />
                    </button>
                    <span class="open-hint">{t(lang, 'home_cardOpen')} <span class="kbd">↵</span></span>
                  </a>
                ))}
              </div>
            </section>
          )
        })}
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="wrap">
      <div class="foot-in">
        <a href={`/${lang}/`} class="brand"><span class="mark"></span><span class="word">{t(lang, 'app_title')}</span></a>
        <nav class="links">
          <a href="#main-content">{t(lang, 'home_catalogLabel')}</a>
          <a href={upstreamRepositoryUrl} target="_blank" rel="noopener">{t(lang, 'home_footerGithub')}</a>
        </nav>
      </div>
      <p class="fineprint">{t(lang, 'home_footerName')} · v{appVersion} · 100% {t(lang, 'home_heroMetaClientSide')}.</p>
    </div>
  </footer>

  <button
    type="button"
    id="home-back-to-top"
    class="fixed bottom-4 right-4 z-40 inline-flex h-12 w-12 items-center justify-center rounded-full border border-border bg-surface-raised/95 text-accent opacity-0 shadow-lg shadow-black/10 backdrop-blur transition-all duration-300 translate-y-2 pointer-events-none hover:-translate-y-0.5 hover:scale-105 hover:text-accent-hover sm:bottom-6 sm:right-6"
    aria-label={t(lang, 'home_backToTopAria')}
    title={t(lang, 'home_backToTopAria')}
    aria-hidden="true"
    tabindex="-1"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 0l-6 6m6-6 6 6" />
    </svg>
  </button>
</div>

<!-- Chrome behaviour: search trigger, theme toggle, back-to-top, scroll spy -->
<script>
  function initHomeSearch() {
    const btn = document.getElementById('home-search-trigger')
    if (btn && btn.dataset['bound'] !== 'true') {
      btn.dataset['bound'] = 'true'
      btn.addEventListener('click', () => {
        document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', metaKey: true }))
      })
    }
  }

  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle')
    if (!btn || btn.dataset['bound'] === 'true') return
    btn.dataset['bound'] = 'true'

    function getStoredPreference(): string {
      return localStorage.getItem('theme') || 'system'
    }
    function updateIcon(pref: string) {
      const iconLight = document.getElementById('theme-icon-light')
      const iconDark = document.getElementById('theme-icon-dark')
      const iconSystem = document.getElementById('theme-icon-system')
      if (!iconLight || !iconDark || !iconSystem) return
      iconLight.classList.add('hidden')
      iconDark.classList.add('hidden')
      iconSystem.classList.add('hidden')
      if (pref === 'light') iconDark.classList.remove('hidden')
      else if (pref === 'dark') iconLight.classList.remove('hidden')
      else iconSystem.classList.remove('hidden')
    }
    function applyTheme(pref: string) {
      let effective = pref
      if (pref === 'system') {
        effective = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      }
      document.documentElement.setAttribute('data-theme', effective)
    }
    function cyclePref(current: string): string {
      if (current === 'system') return 'light'
      if (current === 'light') return 'dark'
      return 'system'
    }

    let pref = getStoredPreference()
    applyTheme(pref)
    updateIcon(pref)

    btn.addEventListener('click', () => {
      pref = cyclePref(pref)
      if (pref === 'system') localStorage.removeItem('theme')
      else localStorage.setItem('theme', pref)
      applyTheme(pref)
      updateIcon(pref)
    })

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getStoredPreference() === 'system') applyTheme('system')
    })
  }

  function initBackToTop() {
    const btn = document.getElementById('home-back-to-top')
    if (!btn || btn.dataset['bound'] === 'true') return
    btn.dataset['bound'] = 'true'
    const threshold = 320
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let isVisible = false
    let ticking = false
    const el = btn
    const setVisible = (visible: boolean) => {
      if (visible === isVisible) return
      isVisible = visible
      el.classList.toggle('opacity-0', !visible)
      el.classList.toggle('translate-y-2', !visible)
      el.classList.toggle('pointer-events-none', !visible)
      el.tabIndex = visible ? 0 : -1
      el.setAttribute('aria-hidden', visible ? 'false' : 'true')
    }
    const onScroll = () => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(() => {
        setVisible(window.scrollY > threshold)
        ticking = false
      })
    }
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' })
    })
    window.addEventListener('scroll', onScroll, { passive: true })
    setVisible(window.scrollY > threshold)
  }

  function initScrollSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#home-toc-list a'))
    if (!links.length) return
    const map: Record<string, HTMLAnchorElement> = {}
    links.forEach((a) => {
      const slug = a.dataset['slug']
      if (slug) map[slug] = a
    })
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            const slug = en.target.id.replace('cat-', '')
            links.forEach((a) => a.classList.remove('active'))
            map[slug]?.classList.add('active')
          }
        })
      },
      { rootMargin: '-30% 0px -60% 0px' },
    )
    document.querySelectorAll('.cat-section').forEach((s) => obs.observe(s))
  }

  function initHomeChrome() {
    initHomeSearch()
    initThemeToggle()
    initBackToTop()
    initScrollSpy()
  }

  initHomeChrome()
  document.addEventListener('astro:page-load', initHomeChrome)
</script>

<!-- Recents + favorites + card-favorite hydration -->
<script define:vars={{ homeToolData, timeStrings, favStrings, lang }} is:inline>
  function timeAgo(ts) {
    var s = (Date.now() - ts) / 1000
    if (s < 60) return timeStrings.justNow
    if (s < 3600) return Math.floor(s / 60) + timeStrings.m
    if (s < 86400) return Math.floor(s / 3600) + timeStrings.h
    return Math.floor(s / 86400) + timeStrings.d
  }

  function readJSON(key) {
    try {
      var raw = localStorage.getItem(key)
      if (!raw) return null
      return JSON.parse(raw)
    } catch (e) {
      return null
    }
  }

  function toolHref(id) {
    return '/' + lang + '/tools/' + id + '/'
  }

  function renderRecents() {
    var row = document.getElementById('home-recents-row')
    var countEl = document.getElementById('home-recents-count')
    if (!row) return
    var recents = readJSON('recent-tools')
    var items = Array.isArray(recents)
      ? recents.filter(function (r) { return r && homeToolData[r.id] }).slice(0, 4)
      : []
    if (countEl) countEl.textContent = items.length ? String(items.length) : ''
    if (!items.length) {
      row.innerHTML = '<div class="fav-empty">' + timeStrings.emptyText + '</div>'
      return
    }
    row.innerHTML = items
      .map(function (r) {
        var d = homeToolData[r.id]
        return (
          '<a class="recent" href="' + toolHref(r.id) + '">' +
          '<span class="tile" style="--tint:' + d.hue + '">' + d.icon + '</span>' +
          '<span class="meta"><span class="name">' + d.name + '</span>' +
          '<span class="sub"><span class="dot" style="background:' + d.hue + '"></span>' + d.cat + '</span></span>' +
          '<span class="when">' + timeAgo(r.ts) + '</span>' +
          timeStrings.arrow +
          '</a>'
        )
      })
      .join('')
  }

  function renderFavorites() {
    var grid = document.getElementById('home-favorites-grid')
    var countEl = document.getElementById('home-favorites-count')
    if (!grid) return
    var favs = readJSON('favorite-tools')
    var items = Array.isArray(favs)
      ? favs.filter(function (id) { return typeof id === 'string' && homeToolData[id] }).slice(0, 5)
      : []
    if (countEl) countEl.textContent = items.length ? String(items.length) : ''
    if (!items.length) {
      grid.innerHTML = '<div class="fav-empty">' + favStrings.emptyText + '</div>'
      return
    }
    grid.innerHTML = items
      .map(function (id) {
        var d = homeToolData[id]
        return (
          '<a class="fav" href="' + toolHref(id) + '">' +
          '<span class="tile" style="--tint:' + d.hue + ';width:34px;height:34px">' + d.iconSm + '</span>' +
          '<span class="name">' + d.name + '</span>' +
          '<span class="star">' + favStrings.star + '</span>' +
          '</a>'
        )
      })
      .join('')
  }

  function syncCardFavorites() {
    var favs = readJSON('favorite-tools')
    var set = Array.isArray(favs) ? favs : []
    document.querySelectorAll('.tool-card').forEach(function (card) {
      card.classList.toggle('is-fav', set.indexOf(card.dataset.id) !== -1)
    })
  }

  function toggleCardFavorite(id) {
    var favs = readJSON('favorite-tools')
    var list = Array.isArray(favs) ? favs.slice() : []
    var idx = list.indexOf(id)
    if (idx === -1) list.unshift(id)
    else list.splice(idx, 1)
    try {
      localStorage.setItem('favorite-tools', JSON.stringify(list))
    } catch (e) {}
    window.dispatchEvent(new CustomEvent('favorites-updated'))
  }

  function renderAll() {
    renderRecents()
    renderFavorites()
    syncCardFavorites()
  }

  if (!window.__homeFavCardBound) {
    window.__homeFavCardBound = true
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('[data-fav]')
      if (btn) {
        e.preventDefault()
        e.stopPropagation()
        toggleCardFavorite(btn.dataset.fav)
      }
    })
    window.addEventListener('favorites-updated', renderAll)
    window.addEventListener('recents-updated', renderRecents)
    document.addEventListener('astro:page-load', renderAll)
  }

  renderAll()
</script>
