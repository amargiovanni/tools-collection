---
import { categories, getToolsByCategory, toolRegistry } from '../config/tools'
import { t, getCategoryName, getToolNameKey } from '../i18n'
import type { Language } from '../i18n'
import { sortToolsByLocalizedName } from '../lib/tool-order'
import { toolIconSvg, iconSvg, hueOf } from '../lib/icons'

interface Props {
  lang: Language
  currentPath?: string
}

const { lang, currentPath } = Astro.props

// Client-side lookup for the favorites group hydration.
const toolNames: Record<string, string> = {}
const toolIcons: Record<string, string> = {}
const toolHues: Record<string, string> = {}
for (const tool of toolRegistry) {
  toolNames[tool.id] = t(lang, getToolNameKey(tool.id))
  toolIcons[tool.id] = toolIconSvg(tool.id, 'icon-sm')
  toolHues[tool.id] = hueOf(tool.category)
}
const favStarSvg = iconSvg('star', 'icon-sm sbfav')
const chevSvg = iconSvg('chev', 'icon-sm chev')
---

<nav class="sb-nav" aria-label="Tool navigation" data-tool-sidebar>
  <!-- Favorites group (populated client-side) -->
  <div
    class="sb-group hidden"
    id="sidebar-favorites"
    data-favorites-section
    data-lang={lang}
    data-current-path={currentPath}
    style="--hue:var(--c-fav)"
  >
    <button
      type="button"
      class="sb-group-head"
      data-toggle
      aria-expanded="true"
      aria-controls="sidebar-favorites-list"
    >
      <span class="ghue"></span>{t(lang, 'favorites_title')}
      <span class="gcount" data-fav-count>0</span>
      <Fragment set:html={chevSvg} />
    </button>
    <div class="sb-items" id="sidebar-favorites-list" data-favorites-list></div>
  </div>

  {categories.map((cat) => {
    const tools = sortToolsByLocalizedName(lang, getToolsByCategory(cat))
    return (
      <div class="sb-group" data-group={cat} style={`--hue:${hueOf(cat)}`}>
        <button
          type="button"
          class="sb-group-head"
          data-toggle
          aria-expanded="true"
          aria-controls={`sb-items-${cat}`}
        >
          <span class="ghue"></span>{getCategoryName(lang, cat)}
          <span class="gcount">{tools.length}</span>
          <Fragment set:html={chevSvg} />
        </button>
        <div class="sb-items" id={`sb-items-${cat}`}>
          {tools.map((tool) => {
            const href = `/${lang}/tools/${tool.id}/`
            const isActive = currentPath === href
            return (
              <a
                class:list={['sb-item', isActive && 'active']}
                href={href}
                data-id={tool.id}
                aria-current={isActive ? 'page' : undefined}
              >
                <Fragment set:html={toolIconSvg(tool.id, 'icon-sm')} />
                <span>{t(lang, getToolNameKey(tool.id))}</span>
                <Fragment set:html={favStarSvg} />
              </a>
            )
          })}
        </div>
      </div>
    )
  })}
</nav>

<!-- Sidebar group collapse + favorites hydration -->
<script define:vars={{ toolNames, toolIcons, toolHues, favStarSvg }} is:inline>
  function updateFavoritesSection(section) {
    var lang = section.dataset.lang
    var currentPath = section.dataset.currentPath
    var list = section.querySelector('[data-favorites-list]')
    var countEl = section.querySelector('[data-fav-count]')
    if (!list) return

    var favIds = []
    try {
      var raw = localStorage.getItem('favorite-tools')
      var parsed = raw ? JSON.parse(raw) : []
      if (Array.isArray(parsed)) favIds = parsed
    } catch (e) {}

    list.innerHTML = ''
    var count = 0
    for (var i = 0; i < favIds.length; i++) {
      var id = favIds[i]
      if (typeof id !== 'string' || !toolNames[id]) continue
      count++
      var href = '/' + lang + '/tools/' + id + '/'
      var isActive = currentPath === href
      var a = document.createElement('a')
      a.className = isActive ? 'sb-item active' : 'sb-item'
      a.href = href
      a.setAttribute('data-id', id)
      if (isActive) a.setAttribute('aria-current', 'page')
      a.innerHTML =
        toolIcons[id] +
        '<span>' + toolNames[id] + '</span>' +
        favStarSvg
      list.appendChild(a)
    }

    if (countEl) countEl.textContent = String(count)
    section.classList.toggle('hidden', count === 0)

    // Mark category items that are favorited (shows the inline star).
    var favSet = {}
    for (var j = 0; j < favIds.length; j++) favSet[favIds[j]] = true
    document.querySelectorAll('[data-tool-sidebar] .sb-group[data-group] .sb-item').forEach(function (el) {
      el.classList.toggle('faved', !!favSet[el.dataset.id])
    })
  }

  function initSidebarFavorites() {
    document.querySelectorAll('[data-favorites-section]').forEach(updateFavoritesSection)
  }

  function bindGroupToggles() {
    document.querySelectorAll('[data-tool-sidebar] [data-toggle]').forEach(function (btn) {
      if (btn.dataset.toggleBound === 'true') return
      btn.dataset.toggleBound = 'true'
      btn.addEventListener('click', function () {
        var group = btn.closest('.sb-group')
        if (!group) return
        var collapsed = group.classList.toggle('collapsed')
        btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true')
      })
    })
  }

  function scrollActiveToolIntoView() {
    document.querySelectorAll('[data-tool-sidebar]').forEach(function (sidebar) {
      var active = sidebar.querySelector('a[aria-current="page"]')
      if (active && active.offsetParent !== null) {
        active.scrollIntoView({ block: 'center', inline: 'nearest' })
      }
    })
  }

  function initSidebar() {
    bindGroupToggles()
    initSidebarFavorites()
    scrollActiveToolIntoView()
  }

  if (!window.__sidebarListenersBound) {
    document.addEventListener('astro:page-load', initSidebar)
    window.addEventListener('favorites-updated', function () {
      initSidebarFavorites()
      scrollActiveToolIntoView()
    })
    window.__sidebarListenersBound = true
  }

  initSidebar()
</script>
