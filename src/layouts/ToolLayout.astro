---
import BaseLayout from './BaseLayout.astro'
import Sidebar from '../components/Sidebar.astro'
import { t, getOtherLanguages, languageNames, getCategoryName, getToolNameKey, getToolDescKey } from '../i18n'
import { ShareButton } from '../components/ui/ShareButton'
import type { Language } from '../i18n'
import type { ToolMeta } from '../config/tools'
import { appVersion, upstreamRepositoryUrl } from '../config/site'
import { getToolsByCategory, toolRegistry } from '../config/tools'
import { iconInner, iconSvg, toolIconSvg, hueOf } from '../lib/icons'

interface Props {
  tool: ToolMeta
  lang: Language
}

const { tool, lang } = Astro.props
const otherLangs = getOtherLanguages(lang)
const toolName = t(lang, getToolNameKey(tool.id))
const toolDesc = t(lang, getToolDescKey(tool.id))
const categoryName = getCategoryName(lang, tool.category)
const hue = hueOf(tool.category)
const currentPath = Astro.url.pathname

// Related tools: same category first, then fill from the rest.
const sameCat = getToolsByCategory(tool.category).filter((x) => x.id !== tool.id)
const others = toolRegistry.filter((x) => x.category !== tool.category && x.id !== tool.id)
const related = [...sameCat, ...others].slice(0, 4)
---

<BaseLayout title={`${toolName} — ${t(lang, 'app_documentTitle')}`} description={toolDesc} lang={lang}>
  <div class="app">
    <!-- SIDEBAR -->
    <aside class="sidebar" aria-label="Tool catalog">
      <a class="sb-brand" href={`/${lang}/`} title={t(lang, 'app_backHomeAria')}>
        <span class="mark"></span>
        <span class="word">{t(lang, 'app_title')}</span>
        <span class="ver">v{appVersion}</span>
      </a>
      <button type="button" class="sb-search" id="tool-search-trigger">
        <Fragment set:html={iconSvg('search', 'icon-sm')} />
        <span class="grow">{t(lang, 'app_searchPlaceholder')}</span>
        <span class="kbd">⌘K</span>
      </button>
      <Sidebar lang={lang} currentPath={currentPath} />
    </aside>

    <!-- MAIN -->
    <div class="main">
      <div class="main-bar">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="ws-btn ws-btn-ghost ws-btn-icon"
          aria-label={t(lang, 'app_mobileMenuAria')}
        >
          <Fragment set:html={iconSvg('menu', 'icon-sm')} />
        </button>
        <nav class="crumb" aria-label="Breadcrumb">
          <a href={`/${lang}/`}>Home</a><span class="sep">/</span>
          <span>{categoryName}</span><span class="sep">/</span>
          <span class="here">{toolName}</span>
        </nav>
        <span class="spacer"></span>
        <div class="main-actions">
          <button type="button" id="tool-search-trigger-bar" class="ws-btn ws-btn-ghost ws-btn-icon" aria-label={t(lang, 'app_searchPlaceholder')}>
            <Fragment set:html={iconSvg('search', 'icon-sm')} />
          </button>
          <button
            type="button"
            id="favorite-toggle"
            data-tool-id={tool.id}
            data-add-label={t(lang, 'favorites_add')}
            data-remove-label={t(lang, 'favorites_remove')}
            class="ws-btn ws-btn-ghost"
            aria-label={t(lang, 'favorites_add')}
          >
            <svg id="fav-icon-empty" class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" set:html={iconInner('star')} />
            <svg id="fav-icon-filled" class="icon icon-sm hidden" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none" style="color:var(--c-fav)" set:html={iconInner('star')} />
            <span data-fav-label>{t(lang, 'favorites_add')}</span>
          </button>
          <button
            type="button"
            id="theme-toggle"
            class="ws-btn ws-btn-ghost ws-btn-icon"
            aria-label={t(lang, 'app_themeToggleAria')}
            title={t(lang, 'app_themeToggleAria')}
          >
            <svg id="theme-icon-light" class="icon icon-sm hidden" viewBox="0 0 24 24" aria-hidden="true" set:html={iconInner('sun')} />
            <svg id="theme-icon-dark" class="icon icon-sm hidden" viewBox="0 0 24 24" aria-hidden="true" set:html={iconInner('moon')} />
            <svg id="theme-icon-system" class="icon icon-sm hidden" viewBox="0 0 24 24" aria-hidden="true" set:html={iconInner('monitor')} />
          </button>
          <div class="relative" data-lang-dropdown>
            <button
              type="button"
              class="lang"
              title={t(lang, 'app_switchLanguageAria')}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {lang.toUpperCase()}
              <Fragment set:html={iconSvg('chev', 'icon-sm')} />
            </button>
            <div class="absolute right-0 top-full z-50 mt-1 hidden min-w-[8rem] overflow-hidden rounded-lg border border-border bg-surface-raised shadow-lg" data-lang-menu>
              {otherLangs.map((l) => (
                <a
                  href={`/${l}/tools/${tool.id}/`}
                  class="flex items-center gap-2 px-3 py-2 text-sm text-text-secondary hover:bg-surface hover:text-accent transition-colors"
                >
                  <span class="w-6 font-medium">{l.toUpperCase()}</span>
                  <span class="text-text-muted">{languageNames[l]}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <main id="main-content" class="tool-content">
        <header class="tool-head" style={`--hue:${hue}`}>
          <span class="tile" style={`--tint:${hue}`} set:html={toolIconSvg(tool.id)} />
          <div class="th-body">
            <div class="th-cat">{categoryName}</div>
            <h1 id="tool-heading" tabindex="-1">{toolName}</h1>
            <p class="th-desc">{toolDesc}</p>
          </div>
          <div class="th-actions">
            <ShareButton
              client:load
              label={t(lang, 'share_copy')}
              copiedLabel={t(lang, 'share_copied')}
              unavailableLabel={t(lang, 'share_unavailable')}
            />
          </div>
        </header>

        <slot />

        <section class="related">
          <h2>{t(lang, 'tool_relatedTitle')}</h2>
          <div class="related-grid">
            {related.map((rel) => (
              <a class="rel-card" href={`/${lang}/tools/${rel.id}/`}>
                <span class="tile" style={`--tint:${hueOf(rel.category)}`} set:html={toolIconSvg(rel.id, 'icon-sm')} />
                <span class="name">{t(lang, getToolNameKey(rel.id))}</span>
              </a>
            ))}
          </div>
        </section>

        <footer class="tool-foot">
          <span class="sc"><Fragment set:html={iconSvg('search', 'icon-sm')} /> <span class="kbd">⌘</span><span class="kbd">K</span> {t(lang, 'tool_footSearch')}</span>
          <span class="sc"><span class="kbd">/</span> {t(lang, 'tool_footQuickOpen')}</span>
          <span class="sc"><span class="kbd">⌘</span><span class="kbd">↵</span> {t(lang, 'tool_footRun')}</span>
          <span class="sc">{t(lang, 'tool_footPrivacy')}</span>
        </footer>
      </main>
    </div>

    <div class="sb-scrim" id="sidebar-scrim"></div>
  </div>

  <!-- Repo link for crawlers / footer parity (kept out of the editorial chrome) -->
  <footer class="sr-only">
    <a href={upstreamRepositoryUrl}>{t(lang, 'home_footerGithub')}</a>
  </footer>

  <!-- Shell behaviour: favorites, theme, search, mobile menu, recents -->
  <script>
    import { isFavorite, toggleFavorite } from '../lib/favorites'
    import { recordRecent } from '../lib/recents'

    function initToolLayout() {
      const favBtn = document.getElementById('favorite-toggle')
      const toolId = favBtn?.dataset['toolId'] ?? ''

      // Record this tool visit for "Jump back in".
      if (toolId) recordRecent(toolId)

      // Mobile sidebar toggle
      const menuBtn = document.getElementById('mobile-menu-toggle')
      const sidebar = document.querySelector('.sidebar')
      const scrim = document.getElementById('sidebar-scrim')
      const closeMenu = () => {
        sidebar?.classList.remove('open')
        scrim?.classList.remove('open')
      }
      if (menuBtn && menuBtn.dataset['bound'] !== 'true') {
        menuBtn.dataset['bound'] = 'true'
        menuBtn.addEventListener('click', () => {
          sidebar?.classList.toggle('open')
          scrim?.classList.toggle('open')
        })
      }
      if (scrim && scrim.dataset['bound'] !== 'true') {
        scrim.dataset['bound'] = 'true'
        scrim.addEventListener('click', closeMenu)
      }

      // Focus tool heading on navigation
      document.getElementById('tool-heading')?.focus()

      // Favorite toggle (keeps the empty/filled star contract used by e2e)
      if (favBtn) {
        const addLabel = favBtn.dataset['addLabel'] ?? ''
        const removeLabel = favBtn.dataset['removeLabel'] ?? ''
        const iconEmpty = document.getElementById('fav-icon-empty')
        const iconFilled = document.getElementById('fav-icon-filled')
        const label = favBtn.querySelector('[data-fav-label]')

        const updateFavIcon = () => {
          const fav = isFavorite(toolId)
          iconEmpty?.classList.toggle('hidden', fav)
          iconFilled?.classList.toggle('hidden', !fav)
          favBtn.classList.toggle('on', fav)
          favBtn.setAttribute('aria-label', fav ? removeLabel : addLabel)
          favBtn.setAttribute('title', fav ? removeLabel : addLabel)
          if (label) label.textContent = fav ? removeLabel : addLabel
        }
        updateFavIcon()
        if (favBtn.dataset['favBound'] !== 'true') {
          favBtn.dataset['favBound'] = 'true'
          favBtn.addEventListener('click', () => {
            toggleFavorite(toolId)
            updateFavIcon()
          })
        }
      }

      // Search triggers → open command palette
      ;['tool-search-trigger', 'tool-search-trigger-bar'].forEach((id) => {
        const el = document.getElementById(id)
        if (el && el.dataset['bound'] !== 'true') {
          el.dataset['bound'] = 'true'
          el.addEventListener('click', () => {
            document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', metaKey: true }))
          })
        }
      })

      // Theme toggle (tri-state: system → light → dark)
      const themeBtn = document.getElementById('theme-toggle')
      if (themeBtn && themeBtn.dataset['bound'] !== 'true') {
        themeBtn.dataset['bound'] = 'true'
        const getPref = (): string => localStorage.getItem('theme') || 'system'
        const updateIcon = (pref: string) => {
          const l = document.getElementById('theme-icon-light')
          const d = document.getElementById('theme-icon-dark')
          const s = document.getElementById('theme-icon-system')
          if (!l || !d || !s) return
          l.classList.add('hidden'); d.classList.add('hidden'); s.classList.add('hidden')
          if (pref === 'light') d.classList.remove('hidden')
          else if (pref === 'dark') l.classList.remove('hidden')
          else s.classList.remove('hidden')
        }
        const applyTheme = (pref: string) => {
          let effective = pref
          if (pref === 'system') effective = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          document.documentElement.setAttribute('data-theme', effective)
        }
        const cyclePref = (c: string): string => (c === 'system' ? 'light' : c === 'light' ? 'dark' : 'system')
        let pref = getPref()
        applyTheme(pref); updateIcon(pref)
        themeBtn.addEventListener('click', () => {
          pref = cyclePref(pref)
          if (pref === 'system') localStorage.removeItem('theme')
          else localStorage.setItem('theme', pref)
          applyTheme(pref); updateIcon(pref)
        })
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          if (getPref() === 'system') applyTheme('system')
        })
      }
    }

    // Power-user shortcut: Cmd/Ctrl+Enter runs the tool's primary action
    // (the first enabled primary button inside the tool content). Bound once.
    const w = window as Window & { __toolSubmitBound?: boolean }
    if (!w.__toolSubmitBound) {
      w.__toolSubmitBound = true
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
          const main = document.getElementById('main-content')
          const btn = main?.querySelector<HTMLButtonElement>('[data-primary-action]:not([disabled])')
          if (btn) {
            e.preventDefault()
            btn.click()
          }
        }
      })
    }

    initToolLayout()
    document.addEventListener('astro:page-load', initToolLayout)
  </script>
</BaseLayout>
